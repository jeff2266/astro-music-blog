---
import { getCollection } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<main id="content" class="flex gap-8 justify-between min-w-full">
    <section class="flex-2/3">
        <ul class="space-y-8">
            {
                posts.map((post) => (
                    <li class="bg-secondary p-5 rounded-xs">
                        <a class="cursor-pointer" hx-get={`/blog/${post.id}/`} hx-target="#content">
                            <h4 class="text-xl">{post.data.title}</h4>
                            <p>{post.data.description}</p>
                            <p class="text-sm italic">
                                <FormattedDate date={post.data.pubDate} />
                            </p>
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>
    <aside class="flex-1/3 p-5 rounded-xs bg-secondary">hello</aside>
</main>
