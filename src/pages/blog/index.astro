---
import FormattedDate from "@/components/FormattedDate.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
	posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

<main id="content" class="flex gap-8 justify-between min-w-full">
    <section class="flex-2/3">
        <ul class="space-y-8">
            {
                posts.map((post) => (
                    <li class="bg-secondary p-5 rounded-xs">
                        <a
                            class="cursor-pointer group"
                            hx-get={`/blog/${post.id}/`}
                            hx-target="#content"
                        >
                            <h4 class="text-xl relative pt-5 mb-4">
                                {post.data.title}
                                <span class="absolute left-0 bottom-0 w-0 h-0.5 bg-primary transform transition-all duration-200 group-hover:w-full" />
                            </h4>
                            <p>{post.data.description}</p>
                        </a>
                        <div class="flex justify-between items-end mt-2">
                            <p class="text-sm italic">
                                <FormattedDate date={post.data.pubDate} />
                            </p>
                            <button onclick={`setCurrentMix('${post.data.mix}')`} class="cursor-pointer text-lg" data-play-button>▶</button>
                        </div>
                    </li>
                ))
            }
        </ul>
    </section>
    <aside class="flex-1/3 p-5 rounded-xs bg-secondary">hello</aside>
</main>
