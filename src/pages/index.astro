---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Blog from "@/pages/blog/index.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-[url('/images/background.webp')] bg-top text-primary">
    <div class="max-w-5xl mx-auto mt-12 mb-2">
        <Header />
        <Blog />
    </div>
</body>
</html>
