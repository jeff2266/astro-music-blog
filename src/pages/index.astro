---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Blog from "@/pages/blog/index.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body class="text-primary min-h-screen overflow-hidden">
        <div
            class="relative h-screen overflow-y-auto overflow-x-clip perspective-[10px] transform-3d bg-secondary"
        >
            <!-- Background layer -->
            <div
                class="absolute inset-0 h-[225%] [transform:translateZ(-6px)_scale(1.5)] bg-cover bg-top bg-[url('/images/background-lg.webp')]"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-b from-60% via-transparent to-secondary"
                ></div>
            </div>

            <!-- Foreground content -->
            <div
                class="relative flex flex-col items-center justify-center px-8 [transform:translateZ(0)]"
            >
                <div
                    class="flex-1 w-full max-w-5xl mx-auto px-2 mt-2 sm:mt-12 mb-2"
                >
                    <Header />
                    <Blog />
                </div>
            </div>
            <footer
                id="sc-player-container"
                class="sticky bottom-0 h-[166px] hidden"
            >
                <iframe
                    id="sc-player"
                    width="100%"
                    height="166"
                    allow="autoplay"
                    src="https://w.soundcloud.com/player/?url=https%3A//soundcloud.com/forss/flickermood&auto_play=false&show_comments=false&show_artwork=false&visual=true"
                ></iframe>
            </footer>
        </div>
    </body>
</html>
