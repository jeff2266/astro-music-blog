---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Blog from "@/pages/blog/index.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body
        class="grid grid-rows-[1fr_120px] bg-[url('/images/background.webp')] bg-top text-primary min-h-screen"
    >
        <div class="flex-1 max-w-5xl mx-auto mt-12 mb-2">
            <Header />
            <Blog posts={posts} />
        </div>
        
<button id="playBtn">▶ Play Mixcloud</button>
  <iframe
    width="100%"
    height="120"
    src="https://api.mixcloud.com/NTSRadio/soft-centre-w-excited-state-1st-august-2025/embed-html/"
    frameborder="0"
    id="mc-player"
  ></iframe>
        <footer id="mc-player-container" class="sticky bottom-0 h-[120px]">
        </footer>
    </body>
</html>
