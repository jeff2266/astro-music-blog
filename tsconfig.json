{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": ".", // This is crucial for resolving aliased paths
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  }
}